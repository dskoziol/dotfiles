layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }

    tab name="Shell" focus=true {
        pane name="Shell & Git" borderless=true {
            cwd "/Users/dskoziol/Documents/Code/github/dskoziol/cookwitty"
        }
    }

    tab name="Editor" {
        pane name="Editor (Neovim)" command="nvim" borderless=true {
            cwd "/Users/dskoziol/Documents/Code/github/dskoziol/cookwitty"
            args "."
        }
    }

    tab name="Dev Stack" {
        pane split_direction="vertical" {
            pane name="Next.js Server" command="npm" {
                cwd "/Users/dskoziol/Documents/Code/github/dskoziol/cookwitty"
                args "run" "dev"
            }
            pane split_direction="horizontal" {
                pane name="Supabase DB & Migrations" command="zsh" {
                    cwd "/Users/dskoziol/Documents/Code/github/dskoziol/cookwitty"
                    args "-c" "echo '=== Supabase Development Stack ==='; supabase status; echo ''; echo 'Use this pane for Supabase / DB migrations.'; zsh"
                }
                pane name="CLI / Console" {
                    cwd "/Users/dskoziol/Documents/Code/github/dskoziol/cookwitty"
                }
            }
        }
    }

    tab name="Testing" {
        pane name="Jest Test Watcher" command="npm" borderless=true {
            cwd "/Users/dskoziol/Documents/Code/github/dskoziol/cookwitty"
            args "run" "test:watch"
        }
    }

    tab name="Antigravity" {
        pane name="Antigravity Workspace" command="agy" borderless=true {
            cwd "/Users/dskoziol/Documents/Code/github/dskoziol/cookwitty"
            args "--conversation" "329b3529-f69d-40e2-bcf3-200b33994de3"
        }
    }
}
